{
  "swagger": "2.0",
  "info": {
    "title": "Microsoft Secure Score",
    "description": "Reads Microsoft Secure Score snapshots and recommended-action (control) profiles from Microsoft Graph, and lets an analyst triage a control (assign, note, mark ignored / third party / reviewed).",
    "version": "1.0"
  },
  "host": "graph.microsoft.com",
  "basePath": "/v1.0",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/security/secureScores": {
      "get": {
        "operationId": "ListSecureScores",
        "summary": "List secure score snapshots",
        "description": "Returns the daily Secure Score snapshots for the tenant, newest first. Each snapshot carries the current score, max score, per-control scores and comparative averages.",
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 30,
            "description": "Number of snapshots to return.",
            "x-ms-summary": "Top",
            "x-ms-visibility": "important"
          },
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Number of snapshots to skip.",
            "x-ms-summary": "Skip",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "OData filter, for example: createdDateTime ge 2026-01-01T00:00:00Z",
            "x-ms-summary": "Filter",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SecureScoreCollection"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          }
        }
      }
    },
    "/security/secureScores/{secureScoreId}": {
      "get": {
        "operationId": "GetSecureScore",
        "summary": "Get a single secure score snapshot",
        "description": "Returns one Secure Score snapshot by its id (format: {tenantId}_{yyyy-MM-dd}).",
        "parameters": [
          {
            "name": "secureScoreId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Snapshot id, for example 00000001-0001-0001-0001-000000000001_2026-07-26",
            "x-ms-summary": "Secure score id",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SecureScore"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          }
        }
      }
    },
    "/security/secureScoreControlProfiles": {
      "get": {
        "operationId": "ListControlProfiles",
        "summary": "List recommended actions (control profiles)",
        "description": "Returns the catalogue of Secure Score recommended actions with their max score, rank, remediation guidance, threats addressed and current tenant triage state.",
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 999,
            "description": "Number of controls to return per page. Use a high value to avoid paging in the app.",
            "x-ms-summary": "Top",
            "x-ms-visibility": "important"
          },
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Number of controls to skip.",
            "x-ms-summary": "Skip",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "OData filter, for example: controlCategory eq 'Identity'",
            "x-ms-summary": "Filter",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ControlProfileCollection"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          }
        }
      }
    },
    "/security/secureScoreControlProfiles/{controlId}": {
      "get": {
        "operationId": "GetControlProfile",
        "summary": "Get a recommended action",
        "description": "Returns a single control profile by its id, for example AdminMFA.",
        "parameters": [
          {
            "name": "controlId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Control id, for example AdminMFA",
            "x-ms-summary": "Control id",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ControlProfile"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          }
        }
      },
      "patch": {
        "operationId": "UpdateControlProfile",
        "summary": "Triage a recommended action",
        "description": "Updates the analyst-editable fields on a control: who it is assigned to, the tenant note, and the control state (ignore, thirdParty, reviewed). Requires SecurityEvents.ReadWrite.All. vendorInformation is mandatory in the body.",
        "parameters": [
          {
            "name": "controlId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Control id, for example AdminMFA",
            "x-ms-summary": "Control id",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "return=representation",
            "description": "Set to return=representation to get the updated object back instead of 204 No Content.",
            "x-ms-summary": "Prefer",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ControlProfileUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated (returned when Prefer: return=representation is sent)",
            "schema": {
              "$ref": "#/definitions/ControlProfile"
            }
          },
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          }
        }
      }
    }
  },
